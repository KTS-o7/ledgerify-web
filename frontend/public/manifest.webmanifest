{
  "name": "Ledgerify",
  "short_name": "Ledgerify",
  "description": "Every account, currency and goal in one quiet ledger.",
  "id": "/",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0C0B09",
  "theme_color": "#0C0B09",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add expense", "short_name": "Add", "url": "/activity?new=expense", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Activity", "url": "/activity" },
    { "name": "Budgets", "url": "/budgets" },
    { "name": "Import statement", "url": "/import" }
  ],
  "share_target": {
    "action": "/import/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "file", "accept": ["text/csv", ".csv"] }]
    }
  }
}
